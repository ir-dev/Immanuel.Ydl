{
  // F5 = "ark-ydl (http)". Builds src/Ark.Ydl, starts it with the matching profile from
  // Properties/launchSettings.json (URL + ASPNETCORE_ENVIRONMENT=Development), opens the browser.
  // Needs the C# extension (ms-dotnettools.csharp). Runtime data lands in src/Ark.Ydl/App_Data.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ark-ydl (http)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "ark-ydl: build",
      "program": "${workspaceFolder}/Immanuel.Yt/ark-ydl/src/Ark.Ydl/bin/Debug/net10.0/Ark.Ydl.dll",
      "args": [],
      "cwd": "${workspaceFolder}/Immanuel.Yt/ark-ydl/src/Ark.Ydl",
      "launchSettingsProfile": "http",
      "stopAtEntry": false,
      "console": "internalConsole",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    },
    {
      // Needs a trusted dev certificate once per machine: dotnet dev-certs https --trust
      "name": "ark-ydl (https)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "ark-ydl: build",
      "program": "${workspaceFolder}/Immanuel.Yt/ark-ydl/src/Ark.Ydl/bin/Debug/net10.0/Ark.Ydl.dll",
      "args": [],
      "cwd": "${workspaceFolder}/Immanuel.Yt/ark-ydl/src/Ark.Ydl",
      "launchSettingsProfile": "https",
      "stopAtEntry": false,
      "console": "internalConsole",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    },
    {
      "name": "ark-ydl (attach)",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}
