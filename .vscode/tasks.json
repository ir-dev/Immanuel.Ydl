{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ark-ydl: build",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Immanuel.Yt/ark-ydl/src/Ark.Ydl/Ark.Ydl.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "ark-ydl: test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/Immanuel.Yt/ark-ydl/ark-ydl.sln"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "ark-ydl: watch",
      "type": "process",
      "command": "dotnet",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/Immanuel.Yt/ark-ydl/src/Ark.Ydl/Ark.Ydl.csproj",
        "--launch-profile",
        "http"
      ],
      "isBackground": true,
      "problemMatcher": "$msCompile"
    },
    {
      // Output for Windows IIS (see key_points.txt): framework-dependent win-x64, in-process web.config.
      "label": "ark-ydl: publish for IIS (win-x64)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "publish",
        "${workspaceFolder}/Immanuel.Yt/ark-ydl/src/Ark.Ydl/Ark.Ydl.csproj",
        "-c",
        "Release",
        "-r",
        "win-x64",
        "--self-contained",
        "false",
        "-o",
        "${workspaceFolder}/Immanuel.Yt/ark-ydl/src/Ark.Ydl/bin/publish/iis",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
