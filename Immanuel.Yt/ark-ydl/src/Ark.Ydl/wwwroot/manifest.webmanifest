{
  "name": "ark-ydl — YouTube downloader",
  "short_name": "ark-ydl",
  "description": "Paste a YouTube link and download the video, the audio, a clip or a whole playlist.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0c0d18",
  "theme_color": "#5b4bff",
  "icons": [
    { "src": "/img/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/img/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "categories": ["utilities", "multimedia"]
}
