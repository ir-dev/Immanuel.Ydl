{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Ydl": {
    "DataRoot": null,
    "DownloadRoot": null,
    "MaxConcurrentJobs": 2,
    "MaxConcurrentProbes": 4,
    "MaxActiveJobsPerClient": 4,
    "RetentionMinutes": 120,
    "MaxPlaylistItems": 100,
    "MaxClipSections": 10,
    "MaxDurationMinutes": 0,
    "MaxFileSize": null,
    "ConcurrentFragments": 4,
    "ProbeCacheMinutes": 15,
    "AllowedSites": [ "youtube.com", "youtu.be", "youtube-nocookie.com" ],
    "AllowAnySite": false,
    "CookiesFile": null,
    "Proxy": null,
    "ExtraArgs": [],
    "RateLimit": {
      "ProbesPerMinute": 30,
      "JobsPerMinute": 20
    },
    "Tools": {
      "Directory": null,
      "YtDlpPath": null,
      "FfmpegPath": null,
      "AutoDownloadFfmpeg": true,
      "JsRuntime": "auto",
      "JsRuntimePath": null,
      "AutoDownloadJsRuntime": true,
      "DenoReleaseBase": "https://dl.deno.land/",
      "DenoVersion": "latest",
      "AutoDownloadYtDlp": true,
      "AutoUpdateYtDlp": true,
      "UpdateIntervalHours": 24
    }
  },

  "ark_oauth_client": {
    "Authority": null,
    "ClientId": null
  }
}
