{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Feedback": {
    "DataRoot": null,
    "AppName": "ARK-RAPID",
    "Analysis": {
      "DefaultProfile": "balanced",
      "AllowedProfiles": [ "fast", "balanced", "thorough" ],
      "MaxConcurrentAnalyses": 1,
      "MaxQueued": 12,
      "MaxActivePerClient": 1,
      "InferenceThreads": 0,
      "MaxComments": 800,
      "RepliesPerThread": 3,
      "TimeBudgetSeconds": 90,
      "MaxSequenceTokens": 128,
      "BatchSize": 16,
      "UnloadIdleMinutes": 20,
      "CacheHours": 6,
      "ReportRetentionDays": 365,
      "AutoDownloadModels": true,
      "ModelHost": "https://huggingface.co/",
      "StoreComments": true,
      "ShowRecentReports": true,
      "Models": {}
    },
    "YouTube": {
      "ApiKey": null,
      "Source": "auto",
      "ExtraExtractorArgs": null,
      "CookiesFile": null,
      "Proxy": null,
      "FetchTimeoutSeconds": 600
    },
    "Tools": {
      "Directory": null,
      "YtDlpPath": null,
      "AutoDownloadYtDlp": true,
      "AutoUpdateYtDlp": true,
      "UpdateIntervalHours": 24,
      "JsRuntimePath": null
    },
    "Audit": {
      "Enabled": true,
      "LogRequests": true,
      "IncludeStaticFiles": false,
      "ExcludePaths": [ "/healthz" ],
      "RetentionMonths": 24,
      "IpMode": "Full",
      "TimeZone": "UTC",
      "CountryHeader": null,
      "FilePrefix": "ark-feedback-audit",
      "GeoIp": {
        "Enabled": true,
        "Edition": "country",
        "AutoDownload": true,
        "DatabasePath": null
      }
    },
    "Admin": {
      "Key": null,
      "Roles": [ "ark-feedback.admin" ],
      "SessionHours": 12
    },
    "RateLimit": {
      "AnalysesPer10Minutes": 6,
      "ApiPerMinute": 120
    }
  },

  "ark_oauth_client": {
    "Authority": null,
    "ClientId": null
  }
}
